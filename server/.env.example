# Environment Variables — Smart Agriculture Management
# Copy this file to .env and fill in the values

# MongoDB Connection String
# Use a standard MongoDB URI, or set to "memory" for in-memory testing
MONGO_URI=memory

# JWT Secret Key (change this in production!)
JWT_SECRET=super_secret_green_agri_key_2026

# Server Port
PORT=5000

# ML Microservice URLs
ML_CROP_API_URL=http://127.0.0.1:5001/predict
PLANT_PIPELINE_URL=http://127.0.0.1:8000

# Set to "true" to use mock ML predictions when Python services are offline
USE_MOCK_ML=true
