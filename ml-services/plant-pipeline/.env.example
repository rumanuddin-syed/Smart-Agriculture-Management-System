# Plant Pipeline FastAPI Service Configuration

# Port to serve on (default: 8000)
PORT=8000

# Path to directory containing trained checkpoints and calibration files
ARTIFACTS_DIR=artifacts

# Enforce calibration JSON presence (1 for true, 0 for false)
REQUIRE_CALIBRATION=1

# Maximum allowable upload size in megabytes
MAX_IMAGE_MB=12

# Inference device: "cpu" or "cuda" (default: auto-detected)
DEVICE=cpu

# Allowed CORS origins, comma-separated (e.g. http://localhost:5173,http://localhost:5000)
CORS_ORIGINS=http://localhost:5173,http://localhost:5000,http://127.0.0.1:5173,http://127.0.0.1:5000

